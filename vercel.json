{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/sync-anime?pages=4&ongoing=3&refresh=25",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/sync-hentai?pages=3",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/sync-games",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/creative-sync?depth=2&mirror=40",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/player-warm?slice=0",
      "schedule": "20 6 * * *"
    },
    {
      "path": "/api/player-warm?slice=1",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/watchdog",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/watchdog",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/watchdog",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/watchdog",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/watchdog",
      "schedule": "30 16 * * *"
    },
    {
      "path": "/api/watchdog",
      "schedule": "30 18 * * *"
    }
  ]
}