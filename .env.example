# ─── Пример переменных окружения (скопировать в .env, НЕ коммитить!) ───
# Все значения — в Supabase Dashboard → Project Settings → API
# и в настройках кошелька ЮMoney.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon/public key>
SUPABASE_SERVICE_ROLE_KEY=<service_role key — ХРАНИТЬ В СЕКРЕТЕ>

# ЮMoney (настройки кошелька → приём платежей)
YOO_MONEY_RECEIVER=410011XXXXXXXXX
YOO_MONEY_SECRET=<секретное слово кошелька>

# Защита cron-эндпоинтов (придумать свою строку)
CRON_SECRET=<произвольная секретная строка>

# LLM-провайдер (для чата с Лилит)
LLM_API_KEY=<ключ>
LLM_BASE_URL=<url>
LLM_MODEL=<модель>

# Админ-аккаунт для диагностических скриптов (scripts/*.mjs)
ADMIN_EMAIL=<email администратора>
ADMIN_PASSWORD=<пароль администратора>
